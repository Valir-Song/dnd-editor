{
  "id": "./",
  "name": "D&D Card Editor",
  "short_name": "Листы D&D",
  "description": "Редактор листов персонажа D&D 5e. Работает без интернета. Версия 3.11.0-beta.15.",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#29253a",
  "theme_color": "#29253a",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-dnd-card-layout+json": [
          ".dnd"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
